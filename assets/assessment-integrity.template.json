{
  "schema_version": "1.0",
  "course_version": "{{course_version}}",
  "evidence_files": [
    {
      "reference_identifier": "material_baseline",
      "path": "{{actual_design_path}}",
      "course_version": "{{course_version}}",
      "content_sha256": "{{actual_file_sha256}}",
      "anchor": "{{baseline_material_anchor}}"
    },
    {
      "reference_identifier": "material_new",
      "path": "{{actual_design_path}}",
      "course_version": "{{course_version}}",
      "content_sha256": "{{actual_file_sha256}}",
      "anchor": "{{new_material_anchor}}"
    },
    {
      "reference_identifier": "rubric",
      "path": "{{actual_evaluation_path}}",
      "course_version": "{{course_version}}",
      "content_sha256": "{{actual_file_sha256}}",
      "anchor": "{{actual_rubric_anchor}}"
    }
  ],
  "tasks": [
    {
      "task_identifier": "task_new",
      "kind": "independent_assessment",
      "material_reference": "material_new",
      "rubric_reference": "rubric",
      "first_response_items": ["response_reason"],
      "answer_related_task_identifiers": [],
      "input_kind": "open",
      "evaluator": "human",
      "initial_evaluation_state": "review_pending",
      "transfer_required": true,
      "transfer_contrast": {
        "baseline_reference": "material_baseline",
        "current_reference": "material_new",
        "invariant_target": "{{same_taught_capability_and_comparable_criteria}}",
        "changed_dimensions": [
          {"kind": "condition", "before": "{{baseline_condition}}", "after": "{{changed_condition}}"}
        ],
        "required_reasoning_adjustment": "{{why_copying_the_baseline_reasoning_is_insufficient}}"
      },
      "transfer_review": {"status": "pending"}
    }
  ],
  "assessment_groups": [
    {
      "group_identifier": "independent_set",
      "task_identifiers": ["task_new"],
      "feedback_release": "all_group_first_responses_persisted_or_assisted",
      "persistence_policy": {
        "requires_durable_write": true,
        "first_responses_immutable": true,
        "write_failure_keeps_locked": true,
        "explicit_missing_record_required": true
      },
      "resource_policy": {
        "allowed_before_release": ["original_material", "accessible_equivalent", "operation_help"],
        "declared_normal_resources": [],
        "knowledge_help_marks_entire_group_assisted": true,
        "persist_assistance_before_reveal": true
      },
      "recovery_policy": {
        "guarded_routes": ["feedback", "rubric", "knowledge_help", "prior_answer_content", "summary", "refresh", "close_reopen", "deep_link", "history", "clear_continue"],
        "restore_from_durable_state": true,
        "missing_corrupt_or_stale_state": "locked",
        "retain_answer_exposure_on_clear_continue": true
      }
    }
  ],
  "result_policy": {
    "missing_is_valid_independent_evidence": false,
    "self_assessment_can_promote_mastery": false,
    "open_response_keyword_scoring": false,
    "revision_overwrites_first_response": false,
    "recheck_can_relabel_original_independent": false
  }
}
